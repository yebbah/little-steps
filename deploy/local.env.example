# Copy to deploy/local.env (git-ignored) and change the values. Everything below is a placeholder.
# docker compose --env-file deploy/local.env -f deploy/compose.yaml up -d --wait

# Use plain letters, digits and - _ . in passwords: $ and } are special to compose and the realm import.
# Ports (all bound to 127.0.0.1). Keycloak must not use 8080: that is the app's port.
LS_POSTGRES_PORT=5432
LS_APP_PORT=8080
LS_KEYCLOAK_PORT=8180
LS_MAILPIT_UI_PORT=8025
LS_MAILPIT_SMTP_PORT=1025

# PostgreSQL: one database, Keycloak in its own schema with its own role.
LS_POSTGRES_DB=littlesteps
LS_POSTGRES_USER=littlesteps
LS_POSTGRES_PASSWORD=change-me-postgres
LS_KEYCLOAK_DB_USER=keycloak
LS_KEYCLOAK_DB_PASSWORD=change-me-keycloak-db

# Keycloak admin console
LS_KEYCLOAK_ADMIN=admin
LS_KEYCLOAK_ADMIN_PASSWORD=change-me-admin

# Fictional local test users in the littlesteps realm
LS_CAREGIVER_A_PASSWORD=change-me-caregiver-a
LS_CAREGIVER_B_PASSWORD=change-me-caregiver-b

# Tailscale host (redirect URI https://<host>/*), for example machine.tailnet-name.ts.net
LS_TAILSCALE_HOST=your-machine.your-tailnet.ts.net

# AI (Ollama runs on the host, not in compose). While false, a missing Ollama or model is only a warning.
# Set true (the default from Epic 13) to make dev-up.sh fail unless the model is pulled: ollama pull <model>
LS_AI_REQUIRED=false
OLLAMA_MODEL=qwen3:8b
