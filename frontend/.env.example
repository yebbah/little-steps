# Copy to .env.local. None of these are secrets.
# TEST_ENV: label for reports only.
TEST_ENV=local
# BASE_URL: set to test an already running app; Playwright then does not start Vite.
# BASE_URL=http://localhost:4173
# E2E_PORT: port for the Vite test-mode server Playwright starts.
# E2E_PORT=4173
# API_URL: backend for the optional API samples (e2e/tests/api.health.spec.ts).
# API_URL=http://localhost:8080
# E2E_ALL_BROWSERS: true adds WebKit and Firefox (the nightly matrix).
# E2E_ALL_BROWSERS=false
