{
  "name": "littlesteps-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && stylelint \"src/**/*.css\"",
    "preview": "vite preview",
    "api:types": "bash scripts/api-types.sh",
    "api:check": "bash scripts/api-types.sh --check",
    "lint:test": "bash scripts/lint-rules.test.sh && bash scripts/stylelint-rules.test.sh",
    "typecheck": "tsc -b",
    "icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:e2e:install:all": "playwright install --with-deps chromium webkit firefox"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@seontechnologies/playwright-utils": "^4.6.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "stylelint": "^18.0.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
