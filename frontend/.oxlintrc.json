{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": [
      "warn",
      {
        "allowConstantExport": true
      }
    ],
    "react/jsx-no-literals": [
      "error",
      {
        "noStrings": true,
        "ignoreProps": true
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/surfaces/**"
      ],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "(^|/)shell(/|$)",
                "message": "surfaces never imports from shell (AD-28). Move what both need to a neutral module."
              }
            ]
          }
        ]
      }
    }
  ]
}
