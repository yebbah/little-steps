{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "LittleSteps API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/v1/ping" : {
      "get" : {
        "tags" : [ "ping-controller" ],
        "summary" : "Check that the API answers",
        "description" : "Returns status 'ok' and the requested count. A count outside 1 to 10 is a validation problem.",
        "operationId" : "ping",
        "parameters" : [ {
          "name" : "count",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 1,
            "maximum" : 10,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The API answers",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Pong"
                }
              }
            }
          },
          "400" : {
            "description" : "Count outside 1 to 10 or not a number",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "type" : {
            "type" : "string",
            "format" : "uri"
          },
          "title" : {
            "type" : "string"
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          }
        }
      },
      "Pong" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string"
          },
          "count" : {
            "type" : "integer",
            "format" : "int32"
          }
        }
      }
    }
  }
}
