{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "LittleSteps API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/v1/strategies" : {
      "get" : {
        "tags" : [ "strategy-restriction-controller" ],
        "summary" : "The Family's Strategies",
        "operationId" : "strategies",
        "responses" : {
          "200" : {
            "description" : "The Strategies, oldest first, retired ones included",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/StrategyResponse"
                  }
                }
              }
            }
          },
          "401" : {
            "description" : "No Caregiver",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session" : {
      "get" : {
        "tags" : [ "session-controller" ],
        "summary" : "The demo session",
        "description" : "Demo only: the Caregiver and Family the request runs as, and every demo Caregiver. 401 unless the demo flag is on.",
        "operationId" : "session",
        "responses" : {
          "200" : {
            "description" : "The demo session",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SessionResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "No Caregiver, or the demo flag is off",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/restrictions" : {
      "get" : {
        "tags" : [ "strategy-restriction-controller" ],
        "summary" : "The Family's Restrictions",
        "operationId" : "restrictions",
        "responses" : {
          "200" : {
            "description" : "The Restrictions, oldest first, retired ones included",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/RestrictionResponse"
                  }
                }
              }
            }
          },
          "401" : {
            "description" : "No Caregiver",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/prompt-levels" : {
      "get" : {
        "tags" : [ "care-team-controller" ],
        "summary" : "The Family's ordered Prompt Levels",
        "operationId" : "promptLevels",
        "responses" : {
          "200" : {
            "description" : "The Prompt Levels in order, retired ones included",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/PromptLevelResponse"
                  }
                }
              }
            }
          },
          "401" : {
            "description" : "No Caregiver",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ping" : {
      "get" : {
        "tags" : [ "ping-controller" ],
        "summary" : "Check that the API answers",
        "description" : "Returns status 'ok' and the requested count. A count outside 1 to 10 is a validation problem.",
        "operationId" : "ping",
        "parameters" : [ {
          "name" : "count",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 1,
            "maximum" : 10,
            "minimum" : 1
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The API answers",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Pong"
                }
              }
            }
          },
          "400" : {
            "description" : "Count outside 1 to 10 or not a number",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/goals" : {
      "get" : {
        "tags" : [ "goal-controller" ],
        "summary" : "The Family's Goals",
        "operationId" : "goals",
        "responses" : {
          "200" : {
            "description" : "The Goals, oldest first, retired ones included",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/GoalResponse"
                  }
                }
              }
            }
          },
          "401" : {
            "description" : "No Caregiver",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/goal-periods" : {
      "get" : {
        "tags" : [ "goal-controller" ],
        "summary" : "The Family's Goal Periods",
        "operationId" : "periods",
        "responses" : {
          "200" : {
            "description" : "The Goal Periods, earliest start first",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/GoalPeriodResponse"
                  }
                }
              }
            }
          },
          "401" : {
            "description" : "No Caregiver",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/child-profile" : {
      "get" : {
        "tags" : [ "child-profile-controller" ],
        "summary" : "The Family's Child Profile",
        "operationId" : "get",
        "responses" : {
          "200" : {
            "description" : "The Child Profile",
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ChildProfileResponse"
                }
              }
            }
          },
          "401" : {
            "description" : "No Caregiver",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404" : {
            "description" : "The Family has no Child Profile (problem type not-found)",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/care-team-members" : {
      "get" : {
        "tags" : [ "care-team-controller" ],
        "summary" : "The Family's Care Team Members, each with a Status Vocabulary and Prompt Level mapping",
        "operationId" : "members",
        "responses" : {
          "200" : {
            "description" : "The Care Team Members, oldest first",
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/CareTeamMemberResponse"
                  }
                }
              }
            }
          },
          "401" : {
            "description" : "No Caregiver",
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
